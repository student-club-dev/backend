// ElonUz — student discounts platform
// Prisma schema (Phase 1 — catalog). PostgreSQL 16 + PostGIS.
//
// Conventions:
//   - Model names: PascalCase. Prisma field names: camelCase.
//   - DB tables/columns: snake_case via @map / @@map.
//   - Money (originalPrice, discountValue, finalPrice, priceDelta, amount): BigInt (whole so'm).
//   - Every entity has created_at / updated_at. Soft-delete via status (ARCHIVED) for
//     Business and Listing — no physical delete.
//
// DESIGN DECISIONS (see report / bottom-of-file migration note):
//   1. CourseYear: Prisma enum values cannot start with a digit, so the wire values
//      "1".."4" are named YEAR_1..YEAR_4 and @map'd back to "1".."4". "MASTER" is unchanged.
//   2. PostGIS: lat/lng are stored as Float (Prisma-managed, used by the REST API and the
//      app-side haversine). A geography(Point,4326) column `geo_point` is declared as an
//      Unsupported type so Prisma keeps it in the schema. The GiST index is modelled via
//      `@@index(type: Gist)` below; only geo_point auto-population from lat/lng is raw SQL (a trigger).
//   3. AttributeKind includes MULTI_SELECT to match the source-of-truth OpenAPI
//      (AttributeFieldTypeDto) and catalog-seed.json `attributeKinds` — this is a superset of
//      BACKEND_PROMPT §5 (which omits it). Flagged for the orchestrator.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, pg_trgm]
}

// ============================================================================
// ENUMS (BACKEND_PROMPT §5 + AUTH OVERRIDE)
// ============================================================================

enum Gender {
  MALE
  FEMALE
}

// Who may see a student's `online` / `lastSeenAt` (Telegram-style last-seen privacy, C7).
enum LastSeenVisibility {
  EVERYONE
  CONNECTIONS
  NOBODY
}

/// Who may see a student's phone number. Same three audiences as LastSeenVisibility and the same
/// resolution logic, but a separate type: the two settings are independently chosen by the user, and
/// sharing one Postgres enum would make adding an audience to one of them silently change both.
enum PhoneVisibility {
  EVERYONE
  CONNECTIONS
  NOBODY
}

enum BusinessStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  BLOCKED
  ARCHIVED
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  REJECTED
  SCHEDULED
  ACTIVE
  PAUSED
  EXPIRED
  SOLD_OUT
  ARCHIVED
}

enum PriceUnit {
  PER_ITEM
  PER_HOUR
  PER_KG
  PER_MONTH
  PER_COURSE
  PER_LESSON
  PER_TICKET
  PER_PERSON
  PER_SESSION
}

enum DiscountType {
  PERCENT
  FIXED_AMOUNT
  SPECIAL_PRICE
  FREE_ITEM
}

enum RedemptionMethod {
  QR
  PROMO_CODE
  STUDENT_ID
  ONLINE_LINK
}

enum RedemptionPeriod {
  DAY
  WEEK
  MONTH
  TOTAL
}

enum SelectionType {
  SINGLE
  MULTIPLE
}

/// Student-posted listing kinds. DISCOUNT (business) is deliberately absent — that is the separate
/// `Listing` model. Wire values match ListingKindDto on the client.
enum StudentListingKind {
  RENTAL
  SERVICE
  JOB
  TASK
}

/// Price units for student listings. Intentionally NOT the shared `PriceUnit`: adding PER_DAY and
/// PER_PAGE there would silently widen the business listing contract, whose generated provider
/// client would then be out of sync with what the server accepts. Wire strings are identical.
enum StudentPriceUnit {
  PER_ITEM
  PER_HOUR
  PER_KG
  PER_DAY
  PER_MONTH
  PER_COURSE
  PER_LESSON
  PER_TICKET
  PER_PERSON
  PER_SESSION
  PER_PAGE
}

/// Visibility scope of a student listing. Phase 1 stores it but always behaves as ALL; enforcement
/// arrives with the universities work (STUDENT_LISTINGS_BACKEND.md §7.2.4).
enum ListingAudience {
  ALL
  NEARBY_UNIVERSITIES
  MY_UNIVERSITY
}

// Wire values are "1".."4","MASTER"; Prisma enum values can't start with a digit.
enum CourseYear {
  YEAR_1 @map("1")
  YEAR_2 @map("2")
  YEAR_3 @map("3")
  YEAR_4 @map("4")
  MASTER
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

// NOTE: MULTI_SELECT is present in the OpenAPI (AttributeFieldTypeDto) and catalog-seed.json
// but NOT in BACKEND_PROMPT §5. Included here to match the source of truth. See report.
enum AttributeKind {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTI_SELECT
  TAGS
}

// AUTH OVERRIDE — our own auth (no Firebase).
enum AuthProvider {
  GOOGLE
  APPLE
}

// Account lifecycle for admin ban/suspend (Faza 3). DELETED is reserved for the account-delete run
// (declared now so no re-migration later); it is NOT set by this run.
enum StudentStatus {
  ACTIVE
  BANNED
  DELETED
}

enum BusinessOwnerStatus {
  ACTIVE
  BANNED
  DELETED
}

// Trade centers (savdo markazlari) — per-center dynamic location fields.
enum TradeCenterStatus {
  ACTIVE
  INACTIVE
}

enum TradeCenterFieldType {
  TEXT
  NUMBER
}

// NOTE: OTP is NOT stored in Postgres — it lives in Redis (see docs/architecture/otp-sms-eskiz.md).
// The former OtpCode model / OtpPurpose enum were removed before the first migration.

// ============================================================================
// AUTH / ACCOUNTS (D6 — two separate account tables; each holds its own auth)
// ============================================================================

// Student account (student mobile app). Auth fields + student-specific profile.
model Student {
  id            String  @id @default(cuid())
  email         String? @unique
  passwordHash  String? @map("password_hash")
  phoneNumber   String? @unique @map("phone_number") // E.164
  phoneVerified Boolean @default(false) @map("phone_verified")
  emailVerified Boolean @default(false) @map("email_verified")
  firstName     String? @map("first_name")
  lastName      String? @map("last_name")
  avatarUrl     String? @map("avatar_url")
  username      String? @unique
  /// Short free-text blurb on the profile screen. Capped in the column, not just in the DTO, so a
  /// direct write cannot smuggle in a longer one. Links and phone numbers are rejected by the
  /// service — a bio is the cheapest ad slot on a social app if you let it be one.
  bio           String? @db.VarChar(140)

  // Student-specific profile
  gender          Gender?
  universityId    String?     @map("university_id")
  universityEmail String?     @map("university_email")
  birthYear       Int?        @map("birth_year")
  courseYear      CourseYear? @map("course_year")

  /// Where the student actually lives — the geo half of "is this job relevant to me" (push
  /// catalogue §3.3 №9). Plain columns rather than FKs, exactly like `StudentListingBranch`: the
  /// seeded district set and the client's GeoCatalog have not been reconciled, and a hard FK would
  /// reject a legitimate value the moment the two lists drift.
  ///
  /// Null until the app starts collecting it, and the matcher treats null as "no geo signal" rather
  /// than as a filter — a student who has not told us where they are still gets matched on
  /// university and course instead of silently receiving nothing.
  regionId        String?     @map("region_id")
  districtId      String?     @map("district_id")

  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  lastSeenAt         DateTime?          @map("last_seen_at")
  // Who may see `lastSeenAt`/`online` (C7 privacy). CONNECTIONS matches the pre-existing behaviour.
  lastSeenVisibility LastSeenVisibility @default(CONNECTIONS) @map("last_seen_visibility")
  /// Who may see `phoneNumber` on this student's summary. Defaults to NOBODY, unlike the last-seen
  /// switch: every existing student gave us their number to sign in with, not to publish, and a
  /// default that exposes it would opt them into spam calls without ever asking.
  phoneVisibility    PhoneVisibility    @default(NOBODY) @map("phone_visibility")

  // Admin ban/suspend (Faza 3). A non-ACTIVE account cannot log in or refresh.
  status    StudentStatus @default(ACTIVE)
  bannedAt  DateTime?     @map("banned_at")
  banReason String?       @map("ban_reason")

  oauthAccounts StudentOAuthAccount[]
  refreshTokens StudentRefreshToken[]
  redemptions   Redemption[]
  favorites     StudentFavorite[]

  // Student-posted listings (STUDENT_LISTINGS_BACKEND.md). Virtual — emits no column.
  studentListings     StudentListing[]
  studentListingViews StudentListingView[]

  // Connections & social graph (chat gate)
  connectionRequestsSent     Connection[] @relation("ConnectionRequester")
  connectionRequestsReceived Connection[] @relation("ConnectionAddressee")
  blocksMade                 Block[]      @relation("BlockBlocker")
  blocksReceived             Block[]      @relation("BlockBlocked")
  reportsMade                Report[]     @relation("ReportReporter")
  reportsAgainst             Report[]     @relation("ReportTarget")

  // Chat
  conversationMemberships ConversationMember[]
  messagesSent            Message[]
  hiddenMessages          MessageHidden[]
  mediaAssets             MediaAsset[]
  uploadSessions          UploadSession[]
  deviceTokens            DeviceToken[]
  notifications           Notification[]

  callsMade     Call[]     @relation("CallCaller")
  callsReceived Call[]     @relation("CallCallee")
  callStats     CallStat[]

  // Profile & stories
  profilePhotos ProfilePhoto[]
  stories       Story[]
  storyViews    StoryView[]

  // Discovery filters on GET /v1/students — one index per column so Postgres can bitmap-AND any
  // combination of them; `createdAt` backs the RECENT sort.
  @@index([universityId])
  @@index([courseYear])
  @@index([gender])
  @@index([birthYear])
  @@index([createdAt])
  @@index([status])
  @@map("students")
}

// Business-owner account (provider mobile app). Auth fields + personal identity only;
// business details live in Business.
model BusinessOwner {
  id            String  @id @default(cuid())
  email         String? @unique
  passwordHash  String? @map("password_hash")
  phoneNumber   String? @unique @map("phone_number") // E.164
  phoneVerified Boolean @default(false) @map("phone_verified")
  emailVerified Boolean @default(false) @map("email_verified")
  firstName     String? @map("first_name")
  lastName      String? @map("last_name")
  avatarUrl     String? @map("avatar_url")
  gender        Gender?

  // Admin ban/suspend (Faza 3). A non-ACTIVE account cannot log in or refresh.
  status    BusinessOwnerStatus @default(ACTIVE)
  bannedAt  DateTime?           @map("banned_at")
  banReason String?             @map("ban_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  oauthAccounts BusinessOwnerOAuthAccount[]
  refreshTokens BusinessOwnerRefreshToken[]
  businesses    Business[]

  @@index([status])
  @@map("business_owners")
}

model StudentOAuthAccount {
  id                String       @id @default(cuid())
  studentId         String       @map("student_id")
  provider          AuthProvider
  providerAccountId String       @map("provider_account_id")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([studentId])
  @@map("student_oauth_accounts")
}

model BusinessOwnerOAuthAccount {
  id                String       @id @default(cuid())
  businessOwnerId   String       @map("business_owner_id")
  provider          AuthProvider
  providerAccountId String       @map("provider_account_id")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  businessOwner BusinessOwner @relation(fields: [businessOwnerId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([businessOwnerId])
  @@map("business_owner_oauth_accounts")
}

model StudentRefreshToken {
  id         String    @id @default(cuid())
  studentId  String    @map("student_id")
  tokenHash  String    @unique @map("token_hash")
  // Device / session metadata (D3)
  deviceName String?   @map("device_name")
  platform   String?
  ipAddress  String?   @map("ip_address")
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_refresh_tokens")
}

model BusinessOwnerRefreshToken {
  id              String    @id @default(cuid())
  businessOwnerId String    @map("business_owner_id")
  tokenHash       String    @unique @map("token_hash")
  // Device / session metadata (D3)
  deviceName      String?   @map("device_name")
  platform        String?
  ipAddress       String?   @map("ip_address")
  lastUsedAt      DateTime? @map("last_used_at")
  expiresAt       DateTime  @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  businessOwner BusinessOwner @relation(fields: [businessOwnerId], references: [id], onDelete: Cascade)

  @@index([businessOwnerId])
  @@map("business_owner_refresh_tokens")
}

// ============================================================================
// CATALOG (seeded from catalog-seed.json; served by the catalog endpoints)
// ============================================================================

// Top-level grouping over the 27 business types (STUDENT_FEED.md, Ilova). The mapping lives in
// the DB, NOT in code — moving a type to another group must not require an app release.
model CatalogGroup {
  key         String   @id
  nameUz      String   @map("name_uz")
  nameRu      String?  @map("name_ru")
  emoji       String?
  icon        String?
  accentColor String?  @map("accent_color")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  businessTypes BusinessTypeInfo[]

  @@map("catalog_groups")
}

// BusinessType is data-driven, NOT an enum. `type` is the string PK.
model BusinessTypeInfo {
  type                String      @id
  groupKey            String      @map("group_key")
  nameUz              String      @map("name_uz")
  nameRu              String?     @map("name_ru")
  emoji               String?
  accentColor         String?     @map("accent_color")
  iconUrl             String?     @map("icon_url")
  defaultPriceUnit    PriceUnit   @map("default_price_unit")
  priceUnits          PriceUnit[] @default([]) @map("price_units")
  availableForGenders Gender[]    @default([]) @map("available_for_genders")
  allCategoryLabel    String?     @map("all_category_label")
  optionGroupHint     String?     @map("option_group_hint")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  group          CatalogGroup    @relation(fields: [groupKey], references: [key], onDelete: Restrict)
  categories     Category[]
  attributeSpecs AttributeSpec[]
  businesses     Business[]

  @@index([groupKey])
  @@map("business_types")
}

model Category {
  id                 String   @id @default(cuid())
  businessType       String   @map("business_type")
  // null = the type's base list; set only for CLOTHING gender-specific lists
  // (catalog-seed.json `categoriesByGender`). See report re: the unique key.
  gender             Gender?
  key                String
  nameUz             String   @map("name_uz")
  nameRu             String?  @map("name_ru")
  iconUrl            String?  @map("icon_url")
  sortOrder          Int      @default(0) @map("sort_order")
  // true for OTHER — the client then requires customCategoryName
  requiresCustomName Boolean  @default(false) @map("requires_custom_name")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  businessTypeInfo BusinessTypeInfo @relation(fields: [businessType], references: [type], onDelete: Restrict)

  @@unique([businessType, gender, key])
  @@map("categories")
}

// Attribute schema for the dynamic listing form (catalog-seed.json `attributes` +
// `categoryAttributes`; served by GET /business/types/{type}/attributes-schema and
// embedded in CategoryDto.fields[]).
model AttributeSpec {
  id           String        @id @default(cuid())
  businessType String        @map("business_type")
  // null = type-level attribute; set for category-level (e.g. GAME_CLUB / PLAYSTATION)
  categoryKey  String?       @map("category_key")
  key          String
  label        String
  kind         AttributeKind
  required     Boolean       @default(false)
  hint         String?
  suffix       String?
  multiple     Boolean?
  // Option list for SELECT / MULTI_SELECT. Seed uses string[]; API serves {value,label}[].
  options      Json?
  sortOrder    Int           @default(0) @map("sort_order")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  businessTypeInfo BusinessTypeInfo @relation(fields: [businessType], references: [type], onDelete: Restrict)

  @@unique([businessType, categoryKey, key])
  @@map("attribute_specs")
}

model Region {
  id        String   @id // e.g. "TOSHKENT_SHAHRI"
  nameUz    String   @map("name_uz")
  nameRu    String?  @map("name_ru")
  centerLat Float?   @map("center_lat")
  centerLng Float?   @map("center_lng")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  districts District[]
  branches  Branch[]

  @@map("regions")
}

model District {
  id        String   @id // e.g. "CHILONZOR"
  regionId  String   @map("region_id")
  nameUz    String   @map("name_uz")
  nameRu    String?  @map("name_ru")
  centerLat Float?   @map("center_lat")
  centerLng Float?   @map("center_lng")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  region   Region   @relation(fields: [regionId], references: [id], onDelete: Restrict)
  branches Branch[]

  @@index([regionId])
  @@map("districts")
}

/// Tashkent metro stations — reference data behind `GET /v1/geo/metro-stations`. It feeds the
/// branch form's `metroStation` autocomplete and the `nearestMetro` hint in reverse-geocoding.
///
/// `Branch.metroStation` stays free text on purpose: an FK would turn a station this table has not
/// caught up with into a failed branch write, and the field is a landmark, not a key.
model MetroStation {
  id        String   @id // e.g. "CHILONZOR" — a readable slug, like Region/District
  nameUz    String   @map("name_uz")
  nameRu    String?  @map("name_ru")
  /// Line slug, so a client can group without string-matching a display name.
  line      String
  lat       Float
  lng       Float
  /// Position along the line, in seed order.
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // No index on (line, sortOrder) on purpose: the only query reads every row and sorts it, and at
  // ~50 rows the planner seq-scans regardless (verified with EXPLAIN ANALYZE). An index nothing
  // uses is write cost with no read benefit.
  @@map("metro_stations")
}

// ============================================================================
// CORE (BACKEND_PROMPT §4)
// ============================================================================

model Business {
  id              String         @id @default(cuid())
  ownerId         String         @map("owner_id")
  type            String // FK -> business_types.type; immutable (enforced in the app layer)
  name            String
  legalName       String?        @map("legal_name")
  inn             String? // 9 digits
  description     String?
  logoUrl         String?        @map("logo_url")
  coverUrl        String?        @map("cover_url")
  phone           String // E.164
  contacts        Json? // { telegram, instagram, website }
  isOnlineOnly    Boolean        @default(false) @map("is_online_only")
  status          BusinessStatus @default(DRAFT)
  rejectionReason String?        @map("rejection_reason")
  rating          Float?
  reviewsCount    Int            @default(0) @map("reviews_count")
  listingsCount   Int            @default(0) @map("listings_count")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  owner            BusinessOwner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  businessTypeInfo BusinessTypeInfo @relation(fields: [type], references: [type], onDelete: Restrict)
  branches         Branch[]
  listings         Listing[]

  @@index([ownerId])
  @@index([type])
  @@index([status])
  @@map("businesses")
}

model Branch {
  id         String  @id @default(cuid())
  businessId String  @map("business_id")
  name       String
  phone      String?
  isActive   Boolean @default(true) @map("is_active")

  // Location (LocationDto — flattened)
  regionId     String  @map("region_id")
  districtId   String  @map("district_id")
  address      String
  landmark     String?
  entranceNote String? @map("entrance_note")
  lat          Float
  lng          Float
  geohash      String? // server-computed, 7 chars
  mapUrl       String? @map("map_url")
  metroStation String? @map("metro_station")

  // PostGIS geography column for proximity search (GET /discounts). Modelled as an
  // Unsupported type so Prisma keeps the column. The GiST index is modelled via the
  // @@index([geoPoint], type: Gist) below; auto-population from lat/lng stays a raw-SQL trigger.
  geoPoint Unsupported("geography(Point, 4326)")? @map("geo_point")

  workingHours Json  @map("working_hours") // [{ day, open, close, isClosed }]
  deliveryZone Json? @map("delivery_zone") // { enabled, radiusMeters, minOrderAmount, ... }

  // Optional trade-center location metadata (savdo markazi). Detached, not deleted,
  // if the center is removed — hence SetNull.
  tradeCenterId String? @map("trade_center_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business        Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  region          Region              @relation(fields: [regionId], references: [id], onDelete: Restrict)
  district        District            @relation(fields: [districtId], references: [id], onDelete: Restrict)
  listingBranches ListingBranch[]
  redemptions     Redemption[]
  workingHourRows BranchWorkingHour[]

  tradeCenter            TradeCenter?                  @relation(fields: [tradeCenterId], references: [id], onDelete: SetNull)
  tradeCenterFieldValues BranchTradeCenterFieldValue[]

  @@index([businessId])
  @@index([regionId, districtId, isActive])
  @@index([tradeCenterId])
  @@index([geoPoint], type: Gist, map: "branches_geo_point_gist") // PostGIS proximity index; keep modelled so migrate dev doesn't DROP it
  @@map("branches")
}

model Listing {
  id                 String    @id @default(cuid())
  businessId         String    @map("business_id")
  categoryKey        String    @map("category_key") // validated against the catalog in the app layer
  customCategoryName String?   @map("custom_category_name")
  title              String
  description        String?
  images             String[]  @default([])
  priceUnit          PriceUnit @map("price_unit")
  originalPrice      BigInt    @map("original_price")
  currency           String    @default("UZS")

  // Discount (server computes finalPrice)
  discountType       DiscountType @map("discount_type")
  discountValue      BigInt       @map("discount_value")
  finalPrice         BigInt       @map("final_price")
  discountConditions String?      @map("discount_conditions")
  appliesToOptions   Boolean      @default(false) @map("applies_to_options")

  // Denormalised from `attributes._regular` (STUDENT_FEED.md D8): a regular listing carries no
  // discount. Kept as a column so listingKind faceting and NULLS-LAST discount sorting are
  // indexable instead of probing jsonb on every row.
  isDiscount      Boolean @default(true) @map("is_discount")
  // Normalised discount percent for sorting/faceting; NULL for regular listings. FIXED_AMOUNT and
  // SPECIAL_PRICE are converted to the equivalent percent, FREE_ITEM counts as 50.
  discountPercent Int?    @map("discount_percent")

  // Search haystack (title, description, category label, text attributes, option names) written by
  // the service. `searchVector` is derived from it by a DB trigger — modelled as Unsupported so
  // Prisma keeps the column, like Branch.geoPoint.
  searchText   String?                  @map("search_text")
  searchVector Unsupported("tsvector")? @map("search_vector")

  // Redemption
  redemptionMethod RedemptionMethod  @map("redemption_method")
  promoCode        String?           @map("promo_code")
  redemptionUrl    String?           @map("redemption_url") // for ONLINE_LINK
  perUserLimit     Int?              @map("per_user_limit")
  perUserPeriod    RedemptionPeriod? @map("per_user_period")
  totalLimit       Int?              @map("total_limit")
  usedCount        Int               @default(0) @map("used_count")

  attributes Json? // Map<string,string> (JSONB; GIN index modelled via @@index below)

  validFrom       DateTime      @map("valid_from")
  validTo         DateTime      @map("valid_to")
  status          ListingStatus @default(DRAFT)
  rejectionReason String?       @map("rejection_reason")
  viewsCount      Int           @default(0) @map("views_count")
  // When the owner last submitted this listing for review. Drives the §6.4 daily submit quota and
  // orders the moderation queue oldest-first (§6.2, 24h SLA). NULL = never submitted, which is
  // correct for every row written before this column existed.
  submittedAt     DateTime?     @map("submitted_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  listingBranches ListingBranch[]
  optionGroups    OptionGroup[]
  redemptions     Redemption[]
  favorites       StudentFavorite[]

  @@index([businessId])
  @@index([status])
  @@index([categoryKey])
  @@index([businessId, status])
  @@index([categoryKey, status])
  @@index([status, validTo])
  @@index([validFrom, validTo])
  @@index([isDiscount])
  @@index([businessId, isDiscount, status])
  // The §6.4 daily quota counts an owner's submissions in a 24h window; the join to business is
  // what makes it owner-scoped, so this index carries the range half of that query.
  @@index([submittedAt])
  @@index([searchVector], type: Gin, map: "listings_search_vector_gin") // full-text search; keep modelled
  @@index([attributes(ops: JsonbPathOps)], type: Gin, map: "listings_attributes_gin") // JSONB attribute-filter index; keep modelled
  @@map("listings")
}

// Listing <-> Branch (spec `branchIds`). Explicit join model.
model ListingBranch {
  listingId String   @map("listing_id")
  branchId  String   @map("branch_id")
  createdAt DateTime @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([listingId, branchId])
  @@index([branchId])
  @@map("listing_branches")
}

model OptionGroup {
  id            String        @id @default(cuid())
  listingId     String        @map("listing_id")
  name          String
  selectionType SelectionType @map("selection_type")
  isRequired    Boolean       @default(false) @map("is_required")
  minSelect     Int?          @map("min_select")
  maxSelect     Int?          @map("max_select")
  sortOrder     Int           @default(0) @map("sort_order")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  listing Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  options Option[]

  @@index([listingId])
  @@map("option_groups")
}

model Option {
  id          String   @id @default(cuid())
  groupId     String   @map("group_id")
  name        String
  priceDelta  BigInt   @default(0) @map("price_delta") // money, may be negative
  isAvailable Boolean  @default(true) @map("is_available")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  group OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("options")
}

// BACKEND_PROMPT §4: id, listingId, studentUserId, branchId?, amount?, redeemedAt.
// NOTE: DISCOUNTS_BUSINESS_API §9 also lists `code` and a status enum
// (PENDING|CONFIRMED|EXPIRED); those are NOT modelled here — flagged for the orchestrator.
enum RedemptionStatus {
  PENDING
  CONFIRMED
  EXPIRED
}

model Redemption {
  id         String           @id @default(cuid())
  listingId  String           @map("listing_id")
  studentId  String           @map("student_id")
  branchId   String?          @map("branch_id")
  code       String           @unique
  status     RedemptionStatus @default(PENDING)
  amount     BigInt? // money
  expiresAt  DateTime?        @map("expires_at")
  redeemedAt DateTime?        @map("redeemed_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // Branch is hard-deletable — keep the redemption record (audit) and null the FK.
  branch  Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([listingId, studentId, redeemedAt])
  @@index([studentId])
  @@index([branchId])
  @@map("redemptions")
}

// ============================================================================
// TRADE CENTERS (savdo markazlari) — dynamic per-center location fields (EAV)
// ============================================================================

model TradeCenter {
  id        String            @id @default(cuid())
  name      String
  slug      String            @unique
  status    TradeCenterStatus @default(ACTIVE)
  sortOrder Int               @default(0) @map("sort_order")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  fields   TradeCenterField[]
  branches Branch[]

  @@index([status, sortOrder])
  @@map("trade_centers")
}

model TradeCenterField {
  id            String               @id @default(cuid())
  tradeCenterId String               @map("trade_center_id")
  label         String // "Qator", "Pavilon", ...
  type          TradeCenterFieldType @default(TEXT)
  required      Boolean              @default(false)
  sortOrder     Int                  @default(0) @map("sort_order")

  tradeCenter TradeCenter                   @relation(fields: [tradeCenterId], references: [id], onDelete: Cascade)
  values      BranchTradeCenterFieldValue[]

  @@index([tradeCenterId, sortOrder])
  @@map("trade_center_fields")
}

// EAV: one row per (branch, field) — the branch's value for a trade-center field.
model BranchTradeCenterFieldValue {
  id       String @id @default(cuid())
  branchId String @map("branch_id")
  fieldId  String @map("field_id")
  value    String

  branch Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  field  TradeCenterField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([branchId, fieldId])
  @@index([fieldId])
  @@map("branch_trade_center_field_values")
}

// ============================================================================
// MIGRATION NOTE — raw SQL to append to the generated migration (PostGIS)
// ----------------------------------------------------------------------------
// Prisma creates the postgis extension (extensions = [postgis]) and the geo_point
// column (Unsupported), but it cannot manage the GiST index or auto-population.
// Add the following to the migration AFTER `prisma migrate dev --create-only`:
//
//   -- keep geo_point in sync with lat/lng
//   CREATE OR REPLACE FUNCTION branches_set_geo_point() RETURNS trigger AS $$
//   BEGIN
//     NEW.geo_point := ST_SetSRID(ST_MakePoint(NEW.lng, NEW.lat), 4326)::geography;
//     RETURN NEW;
//   END;
//   $$ LANGUAGE plpgsql;
//
//   CREATE TRIGGER branches_geo_point_biu
//     BEFORE INSERT OR UPDATE OF lat, lng ON branches
//     FOR EACH ROW EXECUTE FUNCTION branches_set_geo_point();
//
//   -- proximity index for ST_DWithin / ST_Distance (GET /discounts)
//   CREATE INDEX branches_geo_point_gist ON branches USING GIST (geo_point);
//
//   -- optional: JSONB GIN index for attribute filters ("only halal", etc.)
//   CREATE INDEX listings_attributes_gin ON listings USING GIN (attributes jsonb_path_ops);
//
// (A STORED generated column is an alternative to the trigger, but Prisma cannot
//  represent generated columns on Unsupported types, so the trigger is recommended.)
// ============================================================================

// ============================================================================
// STUDENT FEED (STUDENT_FEED.md §11)
// ============================================================================

// Search synonyms per catalog category. `category_key` alone is NOT unique — ALL and OTHER exist
// under every business type — so the natural key includes the type (STUDENT_FEED.md D2).
model CatalogSynonym {
  id           String   @id @default(cuid())
  businessType String   @map("business_type")
  categoryKey  String   @map("category_key")
  term         String
  weight       Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([businessType, categoryKey, term])
  @@index([term])
  // Modelled here rather than left as raw SQL, so `migrate dev` stops emitting a DROP for it.
  @@index([term(ops: raw("gin_trgm_ops"))], map: "catalog_synonyms_term_trgm", type: Gin)
  @@map("catalog_synonyms")
}

// Branch opening hours flattened out of `branches.working_hours` (the JSON stays the wire
// contract). Minutes since midnight make `openNow` an indexable comparison instead of JSON
// arithmetic (STUDENT_FEED.md D11).
model BranchWorkingHour {
  id            String    @id @default(cuid())
  branchId      String    @map("branch_id")
  day           DayOfWeek
  openMinute    Int?      @map("open_minute")
  closeMinute   Int?      @map("close_minute")
  // true when close <= open, i.e. the venue stays open past midnight (20:00-04:00).
  spansMidnight Boolean   @default(false) @map("spans_midnight")
  isClosed      Boolean   @default(false) @map("is_closed")

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, day])
  @@index([day, openMinute, closeMinute])
  @@map("branch_working_hours")
}

// A student's saved listings.
model StudentFavorite {
  studentId String   @map("student_id")
  listingId String   @map("listing_id")
  createdAt DateTime @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([studentId, listingId])
  @@index([listingId])
  @@index([studentId, createdAt])
  @@map("student_favorites")
}

// ---- Connections, blocks & reports (chat gate — docs/architecture/chat.md C1/C11/C12) ----

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ReportReason {
  SPAM
  SCAM
  HARASSMENT
  INAPPROPRIATE
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWED
  ACTIONED
  DISMISSED
}

/// A LinkedIn-style connection edge. Directional request, symmetric once ACCEPTED. One row per pair.
model Connection {
  id          String           @id @default(cuid())
  requesterId String           @map("requester_id")
  addresseeId String           @map("addressee_id")
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")
  respondedAt DateTime?        @map("responded_at")

  requester Student @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee Student @relation("ConnectionAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
  @@map("connections")
}

/// A directional block. Supersedes any connection between the pair.
model Block {
  id        String   @id @default(cuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  blocker Student @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked Student @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

/// A user- or message-level abuse report. `messageId` gains an FK to Message in Plan 2 (chat).
model Report {
  id              String       @id @default(cuid())
  reporterId      String       @map("reporter_id")
  targetStudentId String?      @map("target_student_id")
  messageId       String?      @map("message_id")
  /// A call being complained about (calls spec §14). Third of the three mutually-exclusive
  /// targets. `SetNull` like the others: a report outlives the thing it is about, or a moderator
  /// opening last week's queue would find it empty.
  callId          String?      @map("call_id")
  reason          ReportReason
  note            String?
  contentSnapshot String?      @map("content_snapshot")
  status          ReportStatus @default(OPEN)
  createdAt       DateTime     @default(now()) @map("created_at")

  reporter      Student  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetStudent Student? @relation("ReportTarget", fields: [targetStudentId], references: [id], onDelete: SetNull)
  message       Message? @relation("ReportMessage", fields: [messageId], references: [id], onDelete: SetNull)
  call          Call?    @relation("ReportCall", fields: [callId], references: [id], onDelete: SetNull)

  @@index([targetStudentId])
  /// Not for a query — for the cascade. Deleting a student deletes the reports they filed, and
  /// without this Postgres sequential-scans `reports` to find them (it indexes the PK only).
  @@index([reporterId])
  @@index([callId])
  @@index([status])
  @@map("reports")
}

// ---- Chat (student↔student messaging — docs/architecture/chat.md C3/C4/C5) ----

enum ConversationType {
  DIRECT
  GROUP
}

enum CallMedia {
  AUDIO
  VIDEO
}

/// CONNECTING — `accept` bo'ldi, media hali ulanmadi. Usiz §12.4 dagi 30 soniyalik
/// "accept'dan keyin ulanish" taymeri hech qachon ishlamaydi (dizayn §5.1).
enum CallStatus {
  RINGING
  CONNECTING
  ACTIVE
  ENDED
  MISSED
  DECLINED
  FAILED
  CANCELED
}

enum CallEndReason {
  HANGUP
  TIMEOUT
  DECLINED
  BUSY
  FAILED
  CANCELED
  UNAUTHORIZED
}

/// Kim tugatdi. Student id emas: qiymat faqat ikkitadan biri, va hisob o'chirilsa
/// osilib qolgan id qolmaydi.
enum CallParty {
  CALLER
  CALLEE
}

enum IceCandidateType {
  HOST
  SRFLX
  RELAY
}

enum MessageType {
  TEXT
  IMAGE
  GIF
  VIDEO
  /// Round video message (parity spec §5). Carries a VIDEO_NOTE asset and never a caption.
  VIDEO_NOTE
  FILE
  VOICE
  STICKER
  SYSTEM
  CALL
}

/// A conversation. `DIRECT` (2 members, unique per pair via `directKey`) in v1; `GROUP` reserved.
model Conversation {
  id            String           @id @default(cuid())
  type          ConversationType @default(DIRECT)
  directKey     String?          @unique @map("direct_key")
  nextSeq       Int              @default(1) @map("next_seq")
  lastMessageAt DateTime?        @map("last_message_at")
  createdAt     DateTime         @default(now()) @map("created_at")

  members        ConversationMember[]
  messages       Message[]
  media          MediaAsset[]
  uploadSessions UploadSession[]
  calls          Call[]

  @@index([lastMessageAt])
  @@map("conversations")
}

/// Membership + per-member read/delivered cursors (C5).
model ConversationMember {
  id               String    @id @default(cuid())
  conversationId   String    @map("conversation_id")
  studentId        String    @map("student_id")
  lastReadSeq      Int       @default(0) @map("last_read_seq")
  lastDeliveredSeq Int       @default(0) @map("last_delivered_seq")
  mutedUntil       DateTime? @map("muted_until")
  joinedAt         DateTime  @default(now()) @map("joined_at")

  /// History watermark (§B1): reads filter `seq > clearedBeforeSeq` for THIS member only, so
  /// clearing costs one integer instead of tearing holes in the `seq` axis.
  clearedBeforeSeq Int @default(0) @map("cleared_before_seq")

  /// Removed from this member's list (§B2). A new message clears the flag and the conversation
  /// returns under the same id, so the history never forks.
  hidden Boolean @default(false)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([conversationId, studentId])
  @@index([studentId])
  @@map("conversation_members")
}

/// A message with a per-conversation monotonic `seq` (C4).
model Message {
  id             String      @id @default(cuid())
  conversationId String      @map("conversation_id")
  senderId       String      @map("sender_id")
  seq            Int
  type           MessageType @default(TEXT)
  body           String?
  // Client-generated id — makes a retried send idempotent (C6). Null for server/system messages.
  clientMsgId    String?     @map("client_msg_id")
  // Soft delete (§18). The row stays so `seq` has no holes — history cursors, the read/delivered
  // cursors and unread counts all walk that sequence. Set ⇒ `body` is blanked and the message is
  // excluded from unread counts; the client renders a "message deleted" tombstone.
  deletedAt      DateTime?   @map("deleted_at")
  createdAt      DateTime    @default(now()) @map("created_at")

  // Sticker messages carry no MediaAsset — the sticker is shared catalogue content, not an upload.
  stickerId String? @map("sticker_id")

  // A sticker picked from provider search instead of our catalogue. Referenced, never copied:
  // re-hosting their files is against their terms, which is also why there is no `mediaId` here.
  // Mutually exclusive with `stickerId` — the service rejects a send that carries both, and
  // `MessageDto.sticker` is assembled from whichever one is set so the client sees one shape.
  // Denormalised onto the row on purpose: there is no provider row to join to, and a sticker sent
  // last year must keep rendering even after it leaves the provider's catalogue.
  stickerProvider   MediaProvider? @map("sticker_provider")
  stickerExternalId String?        @map("sticker_external_id")
  stickerUrl        String?        @map("sticker_url")
  stickerThumbUrl   String?        @map("sticker_thumb_url")
  stickerWidth      Int?           @map("sticker_width")
  stickerHeight     Int?           @map("sticker_height")

  // Groups the messages of one multi-image send. Purely presentational: each image stays its own
  // message with its own `seq`, or unread counts and `?after=` paging would break (chat spec §3).
  albumId String? @map("album_id")
  /// How many images the sender is about to put in this album, set on the FIRST message only
  /// (mobile 01-QOLGAN_ISHLAR §1).
  ///
  /// Stored rather than counted because the count is what the push needs, and at the moment the
  /// push is sent only one image has arrived — the rest are still in flight. Without the sender
  /// telling us up front, the notification can only describe the first picture.
  albumSize Int? @map("album_size")

  // Quoted reply (§C). Denormalised like the sticker columns: a snapshot taken at send time, so it
  // keeps rendering after the target is deleted. `replyToMessageId` exists only for "jump to
  // original" and is nulled by the purge cron.
  replyToMessageId  String?      @map("reply_to_message_id")
  replyToSenderId   String?      @map("reply_to_sender_id")
  replyToSenderName String?      @map("reply_to_sender_name")
  replyToSeq        Int?         @map("reply_to_seq")
  replyToType       MessageType? @map("reply_to_type")
  // Capped in the column too: a snapshot is written once and read forever.
  replyToPreview    String?      @map("reply_to_preview") @db.VarChar(120)
  quoteText         String?      @map("quote_text") @db.VarChar(300)
  quoteOffset       Int?         @map("quote_offset")

  // Qo'ng'iroq yozuvi — snapshot, `replyTo*` va `sticker*` bilan bir xil naqsh. `Call` ga
  // JOIN qilinmaydi: ishtirokchi hisobi o'chirilsa Call qatori cascade bilan ketadi, xabar
  // esa qoladi — JOIN'da klient bo'sh "qo'ng'iroq" pufakchasini ko'rardi.
  callId        String?        @map("call_id")
  callMedia     CallMedia?     @map("call_media")
  callStatus    CallStatus?    @map("call_status")
  callDuration  Int?           @map("call_duration_ms")
  callEndReason CallEndReason? @map("call_end_reason")

  conversation Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Student         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  sticker      Sticker?        @relation(fields: [stickerId], references: [id], onDelete: SetNull)
  attachment   MediaAsset?
  reports      Report[]        @relation("ReportMessage")
  hidden       MessageHidden[]
  replyTo      Message?        @relation("MessageReply", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies      Message[]       @relation("MessageReply")

  @@unique([conversationId, seq])
  @@unique([senderId, clientMsgId])
  @@index([conversationId, seq])
  @@index([albumId])
  @@index([stickerId])
  // Serves the SET NULL the purge cron triggers.
  @@index([replyToMessageId])
  @@map("messages")
}

/// Per-member "delete for me" tombstone (§A1). Not a column on `messages`: the same row is visible
/// to one member and hidden from the other.
model MessageHidden {
  studentId String   @map("student_id")
  messageId String   @map("message_id")
  hiddenAt  DateTime @default(now()) @map("hidden_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  // The PK serves the forward reads; this index serves the purge job and the FK cascade.
  @@id([studentId, messageId])
  @@index([messageId])
  @@map("message_hidden")
}

// ---- Calls (1:1 audio/video calling) ----

/// 1:1 qo'ng'iroq yozuvi. Jonli holat Redis'da; bu qator boshlanish va terminal o'tishda
/// yoziladi. Terminal yozuvlar doimo shartli (`WHERE status IN (...)`) — 44.9-soniyadagi
/// `accept` va 45-soniyadagi ring-timeout poygasida holat buzilmasin (dizayn §11).
model Call {
  // ⚠️ uuid, not cuid — unlike every other model here. The id must exist BEFORE the row does: it
  // is written to Redis to claim both participants' busy keys, and only then persisted. Prisma's
  // `cuid()` runs at insert time, so it cannot supply it, and no id generator is installed.
  // `node:crypto.randomUUID()` needs no dependency and is cryptographically random — Prisma's
  // cuid v1 derives part of its value from `Math.random()`, which is predictable. Glare needs only
  // a deterministic total order (see `glare.ts`), which any id format gives.
  id             String         @id @default(uuid())
  conversationId String         @map("conversation_id")
  callerId       String         @map("caller_id")
  calleeId       String         @map("callee_id")
  media          CallMedia
  // Persisted because the relay share in `call_stats` cannot be acted on without it: it does not
  // separate a relay we FORCED (unfamiliar pair, §9.2) from one NAT made unavoidable. Only the
  // split answers the question the number is collected for — "how much would switching `relayOnly`
  // off actually save?". Decided once in `CallsService.invite` and fixed for the call's lifetime,
  // exactly like its `CallState` twin.
  relayOnly      Boolean        @default(false) @map("relay_only")
  status         CallStatus     @default(RINGING)
  startedAt      DateTime       @default(now()) @map("started_at")
  answeredAt     DateTime?      @map("answered_at")
  endedAt        DateTime?      @map("ended_at")
  endReason      CallEndReason? @map("end_reason")
  endedBy        CallParty?     @map("ended_by")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  caller       Student      @relation("CallCaller", fields: [callerId], references: [id], onDelete: Cascade)
  callee       Student      @relation("CallCallee", fields: [calleeId], references: [id], onDelete: Cascade)
  stats        CallStat[]
  reports      Report[]   @relation("ReportCall")

  @@index([callerId, startedAt])
  @@index([calleeId, startedAt])
  @@index([conversationId])
  // Rekonsiliatsiya sweep'i (`status IN ('RINGING','CONNECTING','ACTIVE')`) usiz butun
  // jadvalni skanerlaydi. Partial indeks to'g'riroq bo'lardi, lekin Prisma uni ifodalay
  // olmaydi va keyingi `migrate dev` uni drift deb o'chirishga urinadi.
  @@index([status, startedAt])
  @@map("calls")
}

/// Har ishtirokchining o'z telemetriyasi (3-bosqichda to'ldiriladi). Ikki tomonning
/// metrikasi har xil — biri `RELAY`, ikkinchisi `SRFLX` bo'lishi mumkin — shuning uchun
/// `calls` ustunlari emas, alohida qator.
model CallStat {
  callId          String           @map("call_id")
  studentId       String           @map("student_id")
  rttMs           Int?             @map("rtt_ms")
  packetsLost     Int?             @map("packets_lost")
  packetsReceived Int?             @map("packets_received")
  jitterMs        Int?             @map("jitter_ms")
  // BigInt, not Int: a long video call clears Int32's ~2 GB ceiling, and these are the only numbers
  // the TURN quota forecast can be built on — every other field here describes quality, not volume.
  // Serialized to Number in JSON like all BigInt money fields (CLAUDE.md); byte counts stay far
  // below 2^53, so no precision is lost.
  bytesSent       BigInt?          @map("bytes_sent")
  bytesReceived   BigInt?          @map("bytes_received")
  candidateType   IceCandidateType @map("candidate_type")
  createdAt       DateTime         @default(now()) @map("created_at")

  call    Call    @relation(fields: [callId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([callId, studentId])
  @@index([studentId])
  @@map("call_stats")
}

// ---- Chat media (uploads + sticker catalogue — chat media spec parts A/§1–§5) ----

enum MediaKind {
  IMAGE
  /// The same picture at full resolution (parity spec §3). Only EXIF is stripped; a message carrying
  /// one is still `type: IMAGE`, so the difference is quality rather than how it renders.
  IMAGE_ORIGINAL
  GIF
  VIDEO
  /// Telegram's round video message (parity spec §5). Square, at most a minute, never captioned.
  VIDEO_NOTE
  VOICE
  FILE
  /// One of a student's profile pictures. Not conversation-scoped, and claimed by a ProfilePhoto row
  /// rather than by a message.
  PROFILE_PHOTO
  /// Story media. Same processing as chat images/video (EXIF stripped, H.264/AAC, poster frame),
  /// different retention: the Story row expires after 24h and the cron removes the bytes with it.
  STORY_IMAGE
  STORY_VIDEO
}

enum MediaStatus {
  PROCESSING
  READY
  FAILED
}

/// How hard to try on a video upload (parity spec §4.2). `ORIGINAL` skips the transcode queue
/// entirely — the sender's own encode is what the recipient plays.
enum MediaQuality {
  AUTO
  HIGH
  ORIGINAL
}

/// Where an attachment came from. Null ⇒ the student uploaded it to us.
enum MediaProvider {
  KLIPY
  GIPHY
  /// Retained for rows written before the switch. Tenor's API shut down on 30 June 2026, so nothing
  /// new is ever created with it.
  TENOR
}

/// Hook for NSFW/abuse screening. Nothing enforces it yet — the interface exists so turning
/// screening on later does not require a migration (chat media spec §9).
enum ModerationStatus {
  PENDING
  OK
  BLOCKED
}

/// One chat attachment. Covers both uploads (`storageKey` set) and provider GIFs (`externalUrl`
/// set): Tenor's terms forbid re-hosting, so those are referenced, never copied. Keeping both in one
/// table is what lets `MessageDto.attachment` have a single shape for the client.
model MediaAsset {
  id             String           @id @default(cuid())
  ownerId        String           @map("owner_id")
  // Chat uploads are scoped to a conversation up front: it is the permission check (only a member
  // may upload) and it is what `GET /v1/media/{id}/raw` re-checks on every read.
  //
  // Null for the kinds that have no conversation — PROFILE_PHOTO and the STORY_* pair. Those are
  // authorised by their own rule instead: a profile photo by "any signed-in student", story media by
  // "the owner or someone connected to them". Making the column nullable rather than inventing a
  // sentinel conversation keeps that distinction checkable in one place.
  conversationId String?          @map("conversation_id")
  kind           MediaKind
  status         MediaStatus      @default(READY)
  /// What the sender asked for on a video upload (parity spec §4.2). Null for every other kind, and
  /// for rows written before the field existed — both read as AUTO.
  quality        MediaQuality?
  moderation     ModerationStatus @default(PENDING)
  /// GIFs and the MP4s converted from them — the client autoplays these muted and looping.
  isAnimated     Boolean          @default(false) @map("is_animated")

  /// Object key in our storage. Null for a provider GIF.
  storageKey       String?        @map("storage_key")
  thumbStorageKey  String?        @map("thumb_storage_key")
  /// Provider CDN url. Null for our own uploads — those are served through the authorised proxy.
  externalUrl      String?        @map("external_url")
  externalThumbUrl String?        @map("external_thumb_url")
  provider         MediaProvider?
  externalId       String?        @map("external_id")

  mimeType   String  @map("mime_type")
  sizeBytes  Int     @map("size_bytes")
  width      Int?
  height     Int?
  durationMs Int?    @map("duration_ms")
  /// Normalised RMS points, voice notes only — 100 since parity spec §6, 48 on rows written before
  /// it. Computed server-side; the client cannot derive it from an already-compressed file. Empty
  /// for every other kind.
  waveform   Int[]   @default([])
  /// Speech-to-text for a voice note (parity spec §6). Reserved: nothing writes it yet.
  transcript String?
  /// Alternative renditions, `[{ height, bitrate, url }]` (parity spec §4.3). Reserved: nothing
  /// writes it yet, so the client always sees null and plays `storageKey`.
  variants   Json?
  /// Original upload name for FILE, sanitised. Null for the other kinds.
  fileName   String? @map("file_name")
  blurHash   String? @map("blur_hash")

  /// Set when the asset is attached to a message. Still null after 24h ⇒ the user abandoned the
  /// send, and the cleanup job deletes the row and its bytes (chat media spec §1.4).
  messageId String?  @unique @map("message_id")
  createdAt DateTime @default(now()) @map("created_at")

  owner        Student       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
  profilePhoto ProfilePhoto?
  story        Story?

  // Serves the per-student daily byte quota (SUM(size_bytes) WHERE owner AND created_at > now()-24h).
  @@index([ownerId, createdAt])
  @@index([conversationId])
  // Orphan sweep: unattached rows older than a day.
  @@index([createdAt])
  @@map("media_assets")
}

/// An upload in progress, sent in parts (parity spec §7).
///
/// Holds only what `init` was told. **Which parts have arrived is not stored here** — it is the set
/// of files in the session's directory, read back with a `readdir`. Parts may arrive in any order,
/// in parallel, and more than once, and a column would need every one of those writes to go through
/// `array_append` in raw SQL to avoid losing an update; a filename is atomic for free.
///
/// No `MediaAsset` exists until `complete`, so an abandoned session costs a row and some bytes that
/// the sweep removes after `expiresAt`, and nothing else.
model UploadSession {
  id             String        @id @default(cuid())
  ownerId        String        @map("owner_id")
  /// Required for the chat kinds, exactly as on a one-shot upload; checked again at `complete`.
  conversationId String?       @map("conversation_id")
  kind           MediaKind
  quality        MediaQuality?
  /// Sanitised at `init` — the same treatment a one-shot upload's filename gets.
  fileName       String?       @map("file_name")
  /// The ceiling this session may not exceed — BigInt because the whole point of this endpoint is
  /// files that do not fit in an Int of bytes.
  ///
  /// For an ordinary session it is what the client declared. For a **streaming** one it is the
  /// reserve taken on its behalf, because a client still encoding the video cannot know the size
  /// yet. Either way it is what bounds the part index, the disk check and the quota.
  totalBytes     BigInt        @map("total_bytes")
  /// True when `init` was called without `totalBytes` (streaming upload spec §1). It changes one
  /// thing: `complete` then *requires* `totalBytes` and `parts`, because nothing else in the
  /// session can say where the file ends.
  streaming      Boolean       @default(false)
  chunkSize      Int           @map("chunk_size")
  expiresAt      DateTime      @map("expires_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  owner        Student       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Every lookup is "this student's session", so ownership is checked by the same index that finds it.
  @@index([ownerId])
  // The sweep: everything past its expiry, oldest first.
  @@index([expiresAt])
  @@index([conversationId])
  @@map("upload_sessions")
}

/// A sticker pack. `version` lets the client cache the whole catalogue and refetch only on a bump.
model StickerPack {
  id        String   @id @default(cuid())
  /// Stable human key (`student_life`) — survives reseeding, unlike the cuid.
  key       String   @unique
  name      String
  coverUrl  String   @map("cover_url")
  sortOrder Int      @default(0) @map("sort_order")
  isDefault Boolean  @default(false) @map("is_default")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stickers Sticker[]

  @@map("sticker_packs")
}

/// One sticker: a static 512×512 WebP with a transparent background.
model Sticker {
  id        String   @id @default(cuid())
  packId    String   @map("pack_id")
  emoji     String
  url       String
  width     Int      @default(512)
  height    Int      @default(512)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  pack     StickerPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([packId])
  @@map("stickers")
}

// ---- Profile photos (the swipeable set on the profile screen) ----

/// One of a student's profile pictures. A set rather than a single `avatarUrl`, so the profile
/// screen can page through them the way Telegram's does.
///
/// `url`/`thumbUrl`/`width`/`height` are denormalised from the MediaAsset on purpose: this is read on
/// every profile open and every student list, and joining media on each row to fetch four values
/// that never change would cost more than storing them.
model ProfilePhoto {
  id        String @id @default(cuid())
  studentId String @map("student_id")
  mediaId   String @unique @map("media_id")

  url       String
  thumbUrl  String? @map("thumb_url")
  width     Int?
  height    Int?
  /// Position in the set. 0 is the current avatar — `Student.avatarUrl` is kept in step with it,
  /// because clients already in the field only read `avatarUrl` and would otherwise show a stale
  /// picture to half the user's friends.
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")

  student Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  // Serves both reads there are: "this student's photos, in order" and the per-student count.
  @@index([studentId, sortOrder])
  @@map("profile_photos")
}

// ---- Stories (24-hour posts, gated by the same connection as chat) ----

enum StoryKind {
  IMAGE
  VIDEO
}

/// A story: an image or a short video that disappears 24 hours after it is posted.
model Story {
  id       String    @id @default(cuid())
  authorId String    @map("author_id")
  kind     StoryKind
  mediaId  String    @unique @map("media_id")
  caption  String?   @db.VarChar(200)

  url        String
  thumbUrl   String? @map("thumb_url")
  width      Int?
  height     Int?
  durationMs Int?    @map("duration_ms")

  createdAt DateTime  @default(now()) @map("created_at")
  /// Stored, not computed from `createdAt + 24h`. An expression cannot be indexed the way a column
  /// can, and both the feed filter and the cleanup sweep are driven by exactly this comparison.
  expiresAt DateTime  @map("expires_at")
  /// Set when the author deletes it early. The row survives so the view rows keep their foreign key
  /// until the cleanup pass takes both.
  deletedAt DateTime? @map("deleted_at")

  /// Denormalised count so the author's own list does not aggregate `story_views` per row. Kept in
  /// step by the same statement that inserts the view.
  viewsCount Int @default(0) @map("views_count")

  /// Set once the archive retention window has passed and the bytes were reclaimed. The row stays —
  /// the author still sees the post in their archive, drawn as an empty cell — so this is what tells
  /// the client the file is gone rather than broken.
  archivedMediaPurged Boolean @default(false) @map("archived_media_purged")

  author Student     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media  MediaAsset  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  views  StoryView[]

  // The feed and the archive: one author's stories in date order. Both directions use it.
  @@index([authorId, createdAt])
  // The `expiresAt > now()` filter every feed read carries, and the archive retention sweep.
  @@index([expiresAt])
  // The delete sweep, which runs every ten minutes. Almost every row here is NULL, but a B-tree
  // keeps those at one end, so `deleted_at < $1` reads only the handful that are not.
  @@index([deletedAt])
  @@map("stories")
}

/// Who has seen a story. The composite primary key is what makes `POST /{id}/view` idempotent —
/// re-opening a story cannot inflate the count, because the second insert simply conflicts.
model StoryView {
  storyId  String   @map("story_id")
  viewerId String   @map("viewer_id")
  viewedAt DateTime @default(now()) @map("viewed_at")

  story  Story   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer Student @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@id([storyId, viewerId])
  // "Which of these stories have I already seen" — the feed's `hasUnseen` flag.
  @@index([viewerId])
  @@map("story_views")
}

// ---- Push notifications (device tokens for offline delivery — chat.md C8) ----

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

/// Which APNs host a device token belongs to. A sandbox token rejected by the production host (and
/// the reverse) answers `400 BadDeviceToken`, so the two never mix.
enum ApnsEnvironment {
  PRODUCTION
  SANDBOX
}

/// What kind of token a row holds, and therefore which channel may use it (calls spec §7.3).
///
/// ⚠️ `APNS_VOIP` is a **separate channel with its own rules**: iOS kills an app that receives a
/// VoIP push and does not immediately report an incoming call, and after a few of those it stops
/// delivering VoIP pushes to that device altogether. So a VoIP token must never be handed an
/// ordinary notification — which is why this is a column and not an inference from `platform`.
enum DeviceTokenType {
  FCM
  APNS
  APNS_VOIP
}

/// A student's push token for one device. Routed by `platform`: ANDROID/WEB to FCM, IOS to APNs.
///
/// One iPhone registers **two rows**: its ordinary APNs token for messages and its PushKit token
/// for calls. They are different strings from different Apple APIs, so `token` stays unique and the
/// two never overwrite each other — replacing one with the other would silently disable either
/// messages or calls, with nothing anywhere looking wrong.
model DeviceToken {
  id            String           @id @default(cuid())
  studentId     String           @map("student_id")
  token         String           @unique
  platform      DevicePlatform
  tokenType     DeviceTokenType  @default(FCM) @map("token_type")
  /// Which APNs host accepted this token; iOS only, and null until the first successful send
  /// learns it. Unknown means "try the configured host, then the other one once".
  apnsEnv       ApnsEnvironment? @map("apns_env")
  /// Last delivery Apple/FCM accepted. Diagnostic: a token that has never succeeded is the
  /// signature of a misconfigured push setup, which is otherwise invisible.
  lastSuccessAt DateTime?        @map("last_success_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  // Every send starts with "this student's tokens of this kind" — an ordinary push must exclude
  // the VoIP row, and a call push must select only it.
  @@index([studentId, tokenType])
  @@map("device_tokens")
}

// ---- In-app notifications list (01-NOTIFICATIONS_BACKEND.md) ----

/// Drives the list row's icon and colour and nothing else (§1.1). Adding a value here is safe: the
/// client draws a type it does not recognise as SYSTEM rather than failing the list, which is why
/// the DTO exposes this as a plain string instead of an OpenAPI enum.
enum NotificationType {
  JOB
  DISCOUNT
  LISTING
  CHAT
  CONNECTION
  SYSTEM
}

/// Where tapping a row takes the user (§1.2). A `{type, id}` pair rather than a ready-made deep
/// link, so mobile navigation can be reorganised without the backend moving.
enum NotificationTargetType {
  CHAT
  LISTING
  CONNECTION_REQUESTS
  MY_LISTINGS
  PROFILE
}

/// One row of the in-app notifications list — the history behind the bell icon.
///
/// Written by the same call that sends the push (§1.3): a notification the phone displayed but that
/// cannot be found in the list is a defect, so the two must never have separate write paths.
///
/// Short-lived by design: the retention cron deletes rows past 90 days (§1.3). This is a list, not
/// an archive.
model Notification {
  id         String                  @id @default(cuid())
  studentId  String                  @map("student_id")
  type       NotificationType
  title      String                  @db.VarChar(120)
  /// Optional — a row with no body is drawn as a title-only card (§2.5).
  body       String?                 @db.VarChar(300)
  targetType NotificationTargetType? @map("target_type")
  /// The id `targetType` needs: `conversationId` for CHAT, `listingId` for LISTING. Null for the
  /// target types that address a screen rather than an object, and for `targetType = null`.
  targetId   String?                 @map("target_id")
  readAt     DateTime?               @map("read_at")
  /// Set when quiet hours (22:00–08:00 Tashkent) held the push back — the value is when it is owed
  /// (push catalogue §5.3). Null means nothing is outstanding: either the push already went, or
  /// this row never wanted one. The row itself carries everything the deferred send needs, which is
  /// why the queue is this column rather than a second table that could disagree with it.
  pushDeferredUntil DateTime? @map("push_deferred_until")
  createdAt  DateTime                @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Covers the list query exactly: the `id DESC` tiebreak is part of the index because without it
  // two rows born in the same millisecond swap places between requests (§2.1).
  @@index([studentId, createdAt(sort: Desc), id(sort: Desc)])
  // `unreadCount` — a count of `read_at IS NULL` for one student, on every home screen open (§2.2).
  @@index([studentId, readAt])
  // The 90-day retention sweep, oldest first.
  @@index([createdAt])
  // The quiet-hours flush: "everything owed a push by now". Almost every row is null, so this index
  // stays tiny however large the table grows.
  @@index([pushDeferredUntil])
  @@map("notifications")
}

/// "Have we already sent this one?" — the durable half of the frequency rules (push catalogue §5).
///
/// One table rather than a flag on each of `Listing`, `StudentListing` and `StudentFavorite`,
/// because the question is the same in all three cases and the answer must survive a Redis flush:
/// §5.2 says an expiry reminder goes out **once in a listing's life**, and a cache that forgets
/// turns that into "once per deploy".
///
/// The key encodes what was sent and to whom — `expiry:student-listing:<id>`,
/// `digest:job:<studentId>:<yyyy-mm-dd>`. Claiming is an insert: it either succeeds (first time) or
/// hits the primary key (already sent), which makes it atomic across replicas without a lock.
model NotificationDedup {
  key       String   @id
  createdAt DateTime @default(now()) @map("created_at")

  // The sweep that keeps this table from growing forever, oldest first.
  @@index([createdAt])
  @@map("notification_dedup")
}

// ============================================================================
// STUDENT LISTINGS (STUDENT_LISTINGS_BACKEND.md)
//
// A listing posted by a STUDENT, not a business — four kinds (RENTAL/SERVICE/JOB/TASK). Entirely
// separate from the business `Listing` above: different owner, lifecycle, search and validation.
// The two share only the `ListingStatus` enum, whose nine values already match this contract.
//
// Kind-specific data lives in the `details` JSONB column (source of truth); the mapper also writes
// the flat `rental*`/`service*`/`job*`/`task*` columns below so search can filter and sort on an
// index instead of probing jsonb on every row — the same trade-off `Listing.isDiscount` makes.
// ============================================================================

model StudentListing {
  id      String             @id @default(cuid())
  ownerId String             @map("owner_id")
  kind    StudentListingKind

  // Nullable where a DRAFT may legitimately leave them blank: a half-filled form must save
  // (§6.1), and publish-time validation is what enforces presence.
  title        String            @default("")
  description  String?
  images       String[]          @default([])
  priceUnit    StudentPriceUnit? @map("price_unit")
  price        BigInt            @default(0)
  priceMax     BigInt?           @map("price_max")
  currency     String            @default("UZS")
  isNegotiable Boolean           @default(false) @map("is_negotiable")
  contactPhone String?           @map("contact_phone")

  // §7.2.4. Phase 1 stores both but enforces neither — no universities table exists yet.
  universityId String?         @map("university_id")
  audience     ListingAudience @default(ALL)

  validFrom DateTime? @map("valid_from")
  validTo   DateTime? @map("valid_to")

  attributes   Json @default("{}")
  optionGroups Json @default("[]") @map("option_groups")
  // Polymorphic, discriminated by an inner "kind" that must equal this row's `kind`. JSONB so a new
  // listing kind needs no migration — the client stores it the same way.
  details      Json

  status          ListingStatus @default(DRAFT)
  // Kept for contract parity with the client's ListingStatus; Phase 1 never writes REJECTED, so
  // this stays null. Moderation was dropped as a product decision — submit publishes immediately.
  rejectionReason String?       @map("rejection_reason")
  viewsCount      Int           @default(0) @map("views_count")

  // Haystack built by the service; `searchVector` is derived from it by a DB trigger, like Listing.
  searchText   String?                  @map("search_text")
  searchVector Unsupported("tsvector")? @map("search_vector")

  // Replay guard for POST /v1/student-listings (§7.1). NULLs are distinct in Postgres, so rows
  // without a key never collide on the unique index below.
  idempotencyKey String?   @map("idempotency_key")
  publishedAt    DateTime? @map("published_at")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Denormalised out of `details` by the mapper — filter and sort keys only, never read as truth.
  rentalGender        String?   @map("rental_gender")
  rentalPropertyType  String?   @map("rental_property_type")
  rentalRoomCount     Int?      @map("rental_room_count")
  rentalNeededTenants Int?      @map("rental_needed_tenants")
  serviceType         String?   @map("service_type")
  serviceFormat       String?   @map("service_format")
  serviceHasFreeTrial Boolean?  @map("service_has_free_trial")
  jobEmployment       String?   @map("job_employment")
  jobCategoryKey      String?   @map("job_category_key")
  jobShift            String?   @map("job_shift")
  jobExperience       String?   @map("job_experience")
  taskCategory        String?   @map("task_category")
  taskTypeKey         String?   @map("task_type_key")
  taskFormat          String?   @map("task_format")
  taskDeadline        DateTime? @map("task_deadline")

  owner    Student                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  branches StudentListingBranch[]
  views    StudentListingView[]

  @@unique([ownerId, idempotencyKey])
  @@index([kind, status, validTo])
  @@index([ownerId, updatedAt])
  @@index([status, validTo])
  @@index([kind, status, rentalGender])
  @@index([kind, status, serviceType])
  @@index([kind, status, jobCategoryKey])
  @@index([kind, status, taskCategory])
  @@index([kind, status, taskDeadline])
  @@index([details(ops: JsonbPathOps)], type: Gin, map: "student_listings_details_gin")
  @@index([searchVector], type: Gin, map: "student_listings_search_vector_gin") // keep modelled so migrate dev doesn't DROP it
  @@map("student_listings")
}

/// A map pin on a student listing. NOT a join table like the business `ListingBranch` — a student
/// picks a point on the map, so the address exists only for its listing and dies with it.
///
/// `regionId`/`districtId` are plain columns, not FKs: the seeded district set (210) and the
/// client's GeoCatalog (193) have not been reconciled yet, and a hard FK would reject a legitimate
/// pin the moment the two lists drift. The service validates them against the tables instead.
model StudentListingBranch {
  id        String @id @default(cuid())
  listingId String @map("listing_id")

  lat      Float
  lng      Float
  // Populated from lat/lng by a raw-SQL trigger, exactly like Branch.geoPoint.
  geoPoint Unsupported("geography(Point, 4326)")? @map("geo_point")

  address    String
  name       String?
  landmark   String?
  regionId   String? @map("region_id")
  districtId String? @map("district_id")

  createdAt DateTime @default(now()) @map("created_at")

  listing StudentListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([geoPoint], type: Gist, map: "student_listing_branches_geo_point_gist") // PostGIS proximity index; keep modelled
  @@map("student_listing_branches")
}

/// One student's view of one listing, kept so `viewsCount` counts a person once per 24 hours
/// (§7.2.0) instead of once per screen open. Only the latest view per pair is retained — the row is
/// upserted — because nothing here is analytics, it is purely a rate limit on the counter.
model StudentListingView {
  listingId String   @map("listing_id")
  viewerId  String   @map("viewer_id")
  viewedAt  DateTime @default(now()) @map("viewed_at")

  listing StudentListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  viewer  Student        @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@id([listingId, viewerId])
  /// Same reason, and this is the table that makes it matter: the PK starts with `listingId`, so
  /// the viewer side is unindexed, and this table gains a row per view — the fastest-growing one
  /// a student delete has to cascade through.
  @@index([viewerId])
  @@index([viewedAt])
  @@map("student_listing_views")
}
