// ElonUz — student discounts platform
// Prisma schema (Phase 1 — catalog). PostgreSQL 16 + PostGIS.
//
// Conventions:
//   - Model names: PascalCase. Prisma field names: camelCase.
//   - DB tables/columns: snake_case via @map / @@map.
//   - Money (originalPrice, discountValue, finalPrice, priceDelta, amount): BigInt (whole so'm).
//   - Every entity has created_at / updated_at. Soft-delete via status (ARCHIVED) for
//     Business and Listing — no physical delete.
//
// DESIGN DECISIONS (see report / bottom-of-file migration note):
//   1. CourseYear: Prisma enum values cannot start with a digit, so the wire values
//      "1".."4" are named YEAR_1..YEAR_4 and @map'd back to "1".."4". "MASTER" is unchanged.
//   2. PostGIS: lat/lng are stored as Float (Prisma-managed, used by the REST API and the
//      app-side haversine). A geography(Point,4326) column `geo_point` is declared as an
//      Unsupported type so Prisma keeps it in the schema. The GiST index is modelled via
//      `@@index(type: Gist)` below; only geo_point auto-population from lat/lng is raw SQL (a trigger).
//   3. AttributeKind includes MULTI_SELECT to match the source-of-truth OpenAPI
//      (AttributeFieldTypeDto) and catalog-seed.json `attributeKinds` — this is a superset of
//      BACKEND_PROMPT §5 (which omits it). Flagged for the orchestrator.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ============================================================================
// ENUMS (BACKEND_PROMPT §5 + AUTH OVERRIDE)
// ============================================================================

enum Gender {
  MALE
  FEMALE
}

enum BusinessStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  BLOCKED
  ARCHIVED
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  REJECTED
  SCHEDULED
  ACTIVE
  PAUSED
  EXPIRED
  SOLD_OUT
  ARCHIVED
}

enum PriceUnit {
  PER_ITEM
  PER_HOUR
  PER_KG
  PER_MONTH
  PER_COURSE
  PER_LESSON
  PER_TICKET
  PER_PERSON
  PER_SESSION
}

enum DiscountType {
  PERCENT
  FIXED_AMOUNT
  SPECIAL_PRICE
  FREE_ITEM
}

enum RedemptionMethod {
  QR
  PROMO_CODE
  STUDENT_ID
  ONLINE_LINK
}

enum RedemptionPeriod {
  DAY
  WEEK
  MONTH
  TOTAL
}

enum SelectionType {
  SINGLE
  MULTIPLE
}

// Wire values are "1".."4","MASTER"; Prisma enum values can't start with a digit.
enum CourseYear {
  YEAR_1 @map("1")
  YEAR_2 @map("2")
  YEAR_3 @map("3")
  YEAR_4 @map("4")
  MASTER
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

// NOTE: MULTI_SELECT is present in the OpenAPI (AttributeFieldTypeDto) and catalog-seed.json
// but NOT in BACKEND_PROMPT §5. Included here to match the source of truth. See report.
enum AttributeKind {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTI_SELECT
  TAGS
}

// AUTH OVERRIDE — our own auth (no Firebase).
enum AuthProvider {
  GOOGLE
  APPLE
}

// Trade centers (savdo markazlari) — per-center dynamic location fields.
enum TradeCenterStatus {
  ACTIVE
  INACTIVE
}

enum TradeCenterFieldType {
  TEXT
  NUMBER
}

// NOTE: OTP is NOT stored in Postgres — it lives in Redis (see docs/architecture/otp-sms-eskiz.md).
// The former OtpCode model / OtpPurpose enum were removed before the first migration.

// ============================================================================
// AUTH / ACCOUNTS (D6 — two separate account tables; each holds its own auth)
// ============================================================================

// Student account (student mobile app). Auth fields + student-specific profile.
model Student {
  id            String  @id @default(cuid())
  email         String? @unique
  passwordHash  String? @map("password_hash")
  phoneNumber   String? @unique @map("phone_number") // E.164
  phoneVerified Boolean @default(false) @map("phone_verified")
  emailVerified Boolean @default(false) @map("email_verified")
  firstName     String? @map("first_name")
  lastName      String? @map("last_name")
  avatarUrl     String? @map("avatar_url")

  // Student-specific profile
  gender          Gender?
  universityId    String?     @map("university_id")
  universityEmail String?     @map("university_email")
  birthYear       Int?        @map("birth_year")
  courseYear      CourseYear? @map("course_year")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  oauthAccounts StudentOAuthAccount[]
  refreshTokens StudentRefreshToken[]
  redemptions   Redemption[]

  @@map("students")
}

// Business-owner account (provider mobile app). Auth fields + personal identity only;
// business details live in Business.
model BusinessOwner {
  id            String  @id @default(cuid())
  email         String? @unique
  passwordHash  String? @map("password_hash")
  phoneNumber   String? @unique @map("phone_number") // E.164
  phoneVerified Boolean @default(false) @map("phone_verified")
  emailVerified Boolean @default(false) @map("email_verified")
  firstName     String? @map("first_name")
  lastName      String? @map("last_name")
  avatarUrl     String? @map("avatar_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  oauthAccounts BusinessOwnerOAuthAccount[]
  refreshTokens BusinessOwnerRefreshToken[]
  businesses    Business[]

  @@map("business_owners")
}

model StudentOAuthAccount {
  id                String       @id @default(cuid())
  studentId         String       @map("student_id")
  provider          AuthProvider
  providerAccountId String       @map("provider_account_id")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([studentId])
  @@map("student_oauth_accounts")
}

model BusinessOwnerOAuthAccount {
  id                String       @id @default(cuid())
  businessOwnerId   String       @map("business_owner_id")
  provider          AuthProvider
  providerAccountId String       @map("provider_account_id")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  businessOwner BusinessOwner @relation(fields: [businessOwnerId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([businessOwnerId])
  @@map("business_owner_oauth_accounts")
}

model StudentRefreshToken {
  id         String    @id @default(cuid())
  studentId  String    @map("student_id")
  tokenHash  String    @unique @map("token_hash")
  // Device / session metadata (D3)
  deviceName String?   @map("device_name")
  platform   String?
  ipAddress  String?   @map("ip_address")
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_refresh_tokens")
}

model BusinessOwnerRefreshToken {
  id              String    @id @default(cuid())
  businessOwnerId String    @map("business_owner_id")
  tokenHash       String    @unique @map("token_hash")
  // Device / session metadata (D3)
  deviceName      String?   @map("device_name")
  platform        String?
  ipAddress       String?   @map("ip_address")
  lastUsedAt      DateTime? @map("last_used_at")
  expiresAt       DateTime  @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  businessOwner BusinessOwner @relation(fields: [businessOwnerId], references: [id], onDelete: Cascade)

  @@index([businessOwnerId])
  @@map("business_owner_refresh_tokens")
}

// ============================================================================
// CATALOG (seeded from catalog-seed.json; served by the catalog endpoints)
// ============================================================================

// BusinessType is data-driven, NOT an enum. `type` is the string PK.
model BusinessTypeInfo {
  type                String      @id
  nameUz              String      @map("name_uz")
  nameRu              String?     @map("name_ru")
  emoji               String?
  accentColor         String?     @map("accent_color")
  iconUrl             String?     @map("icon_url")
  defaultPriceUnit    PriceUnit   @map("default_price_unit")
  priceUnits          PriceUnit[] @default([]) @map("price_units")
  availableForGenders Gender[]    @default([]) @map("available_for_genders")
  allCategoryLabel    String?     @map("all_category_label")
  optionGroupHint     String?     @map("option_group_hint")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  categories     Category[]
  attributeSpecs AttributeSpec[]
  businesses     Business[]

  @@map("business_types")
}

model Category {
  id                 String   @id @default(cuid())
  businessType       String   @map("business_type")
  // null = the type's base list; set only for CLOTHING gender-specific lists
  // (catalog-seed.json `categoriesByGender`). See report re: the unique key.
  gender             Gender?
  key                String
  nameUz             String   @map("name_uz")
  nameRu             String?  @map("name_ru")
  iconUrl            String?  @map("icon_url")
  sortOrder          Int      @default(0) @map("sort_order")
  // true for OTHER — the client then requires customCategoryName
  requiresCustomName Boolean  @default(false) @map("requires_custom_name")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  businessTypeInfo BusinessTypeInfo @relation(fields: [businessType], references: [type], onDelete: Restrict)

  @@unique([businessType, gender, key])
  @@map("categories")
}

// Attribute schema for the dynamic listing form (catalog-seed.json `attributes` +
// `categoryAttributes`; served by GET /business/types/{type}/attributes-schema and
// embedded in CategoryDto.fields[]).
model AttributeSpec {
  id           String        @id @default(cuid())
  businessType String        @map("business_type")
  // null = type-level attribute; set for category-level (e.g. GAME_CLUB / PLAYSTATION)
  categoryKey  String?       @map("category_key")
  key          String
  label        String
  kind         AttributeKind
  required     Boolean       @default(false)
  hint         String?
  suffix       String?
  multiple     Boolean?
  // Option list for SELECT / MULTI_SELECT. Seed uses string[]; API serves {value,label}[].
  options      Json?
  sortOrder    Int           @default(0) @map("sort_order")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  businessTypeInfo BusinessTypeInfo @relation(fields: [businessType], references: [type], onDelete: Restrict)

  @@unique([businessType, categoryKey, key])
  @@map("attribute_specs")
}

model Region {
  id        String   @id // e.g. "TOSHKENT_SHAHRI"
  nameUz    String   @map("name_uz")
  nameRu    String?  @map("name_ru")
  centerLat Float?   @map("center_lat")
  centerLng Float?   @map("center_lng")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  districts District[]
  branches  Branch[]

  @@map("regions")
}

model District {
  id        String   @id // e.g. "CHILONZOR"
  regionId  String   @map("region_id")
  nameUz    String   @map("name_uz")
  nameRu    String?  @map("name_ru")
  centerLat Float?   @map("center_lat")
  centerLng Float?   @map("center_lng")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  region   Region   @relation(fields: [regionId], references: [id], onDelete: Restrict)
  branches Branch[]

  @@index([regionId])
  @@map("districts")
}

// ============================================================================
// CORE (BACKEND_PROMPT §4)
// ============================================================================

model Business {
  id              String         @id @default(cuid())
  ownerId         String         @map("owner_id")
  type            String // FK -> business_types.type; immutable (enforced in the app layer)
  name            String
  legalName       String?        @map("legal_name")
  inn             String? // 9 digits
  description     String?
  logoUrl         String?        @map("logo_url")
  coverUrl        String?        @map("cover_url")
  phone           String // E.164
  contacts        Json? // { telegram, instagram, website }
  isOnlineOnly    Boolean        @default(false) @map("is_online_only")
  status          BusinessStatus @default(DRAFT)
  rejectionReason String?        @map("rejection_reason")
  rating          Float?
  reviewsCount    Int            @default(0) @map("reviews_count")
  listingsCount   Int            @default(0) @map("listings_count")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  owner            BusinessOwner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  businessTypeInfo BusinessTypeInfo @relation(fields: [type], references: [type], onDelete: Restrict)
  branches         Branch[]
  listings         Listing[]

  @@index([ownerId])
  @@index([type])
  @@index([status])
  @@map("businesses")
}

model Branch {
  id         String  @id @default(cuid())
  businessId String  @map("business_id")
  name       String
  phone      String?
  isActive   Boolean @default(true) @map("is_active")

  // Location (LocationDto — flattened)
  regionId     String  @map("region_id")
  districtId   String  @map("district_id")
  address      String
  landmark     String?
  entranceNote String? @map("entrance_note")
  lat          Float
  lng          Float
  geohash      String? // server-computed, 7 chars
  mapUrl       String? @map("map_url")
  metroStation String? @map("metro_station")

  // PostGIS geography column for proximity search (GET /discounts). Modelled as an
  // Unsupported type so Prisma keeps the column. The GiST index is modelled via the
  // @@index([geoPoint], type: Gist) below; auto-population from lat/lng stays a raw-SQL trigger.
  geoPoint Unsupported("geography(Point, 4326)")? @map("geo_point")

  workingHours Json  @map("working_hours") // [{ day, open, close, isClosed }]
  deliveryZone Json? @map("delivery_zone") // { enabled, radiusMeters, minOrderAmount, ... }

  // Optional trade-center location metadata (savdo markazi). Detached, not deleted,
  // if the center is removed — hence SetNull.
  tradeCenterId String? @map("trade_center_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  region          Region          @relation(fields: [regionId], references: [id], onDelete: Restrict)
  district        District        @relation(fields: [districtId], references: [id], onDelete: Restrict)
  listingBranches ListingBranch[]
  redemptions     Redemption[]

  tradeCenter            TradeCenter?                  @relation(fields: [tradeCenterId], references: [id], onDelete: SetNull)
  tradeCenterFieldValues BranchTradeCenterFieldValue[]

  @@index([businessId])
  @@index([regionId, districtId, isActive])
  @@index([tradeCenterId])
  @@index([geoPoint], type: Gist, map: "branches_geo_point_gist") // PostGIS proximity index; keep modelled so migrate dev doesn't DROP it
  @@map("branches")
}

model Listing {
  id                 String    @id @default(cuid())
  businessId         String    @map("business_id")
  categoryKey        String    @map("category_key") // validated against the catalog in the app layer
  customCategoryName String?   @map("custom_category_name")
  title              String
  description        String?
  images             String[]  @default([])
  priceUnit          PriceUnit @map("price_unit")
  originalPrice      BigInt    @map("original_price")
  currency           String    @default("UZS")

  // Discount (server computes finalPrice)
  discountType       DiscountType @map("discount_type")
  discountValue      BigInt       @map("discount_value")
  finalPrice         BigInt       @map("final_price")
  discountConditions String?      @map("discount_conditions")
  appliesToOptions   Boolean      @default(false) @map("applies_to_options")

  // Redemption
  redemptionMethod RedemptionMethod  @map("redemption_method")
  promoCode        String?           @map("promo_code")
  redemptionUrl    String?           @map("redemption_url") // for ONLINE_LINK
  perUserLimit     Int?              @map("per_user_limit")
  perUserPeriod    RedemptionPeriod? @map("per_user_period")
  totalLimit       Int?              @map("total_limit")
  usedCount        Int               @default(0) @map("used_count")

  attributes Json? // Map<string,string> (JSONB; GIN index modelled via @@index below)

  validFrom       DateTime      @map("valid_from")
  validTo         DateTime      @map("valid_to")
  status          ListingStatus @default(DRAFT)
  rejectionReason String?       @map("rejection_reason")
  viewsCount      Int           @default(0) @map("views_count")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  listingBranches ListingBranch[]
  optionGroups    OptionGroup[]
  redemptions     Redemption[]

  @@index([businessId])
  @@index([status])
  @@index([categoryKey])
  @@index([businessId, status])
  @@index([categoryKey, status])
  @@index([status, validTo])
  @@index([validFrom, validTo])
  @@index([attributes(ops: JsonbPathOps)], type: Gin, map: "listings_attributes_gin") // JSONB attribute-filter index; keep modelled
  @@map("listings")
}

// Listing <-> Branch (spec `branchIds`). Explicit join model.
model ListingBranch {
  listingId String   @map("listing_id")
  branchId  String   @map("branch_id")
  createdAt DateTime @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([listingId, branchId])
  @@index([branchId])
  @@map("listing_branches")
}

model OptionGroup {
  id            String        @id @default(cuid())
  listingId     String        @map("listing_id")
  name          String
  selectionType SelectionType @map("selection_type")
  isRequired    Boolean       @default(false) @map("is_required")
  minSelect     Int?          @map("min_select")
  maxSelect     Int?          @map("max_select")
  sortOrder     Int           @default(0) @map("sort_order")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  listing Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  options Option[]

  @@index([listingId])
  @@map("option_groups")
}

model Option {
  id          String   @id @default(cuid())
  groupId     String   @map("group_id")
  name        String
  priceDelta  BigInt   @default(0) @map("price_delta") // money, may be negative
  isAvailable Boolean  @default(true) @map("is_available")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  group OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("options")
}

// BACKEND_PROMPT §4: id, listingId, studentUserId, branchId?, amount?, redeemedAt.
// NOTE: DISCOUNTS_BUSINESS_API §9 also lists `code` and a status enum
// (PENDING|CONFIRMED|EXPIRED); those are NOT modelled here — flagged for the orchestrator.
model Redemption {
  id         String   @id @default(cuid())
  listingId  String   @map("listing_id")
  studentId  String   @map("student_id")
  branchId   String?  @map("branch_id")
  amount     BigInt? // money
  redeemedAt DateTime @default(now()) @map("redeemed_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // Branch is hard-deletable — keep the redemption record (audit) and null the FK.
  branch  Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([listingId, studentId, redeemedAt])
  @@index([studentId])
  @@index([branchId])
  @@map("redemptions")
}

// ============================================================================
// TRADE CENTERS (savdo markazlari) — dynamic per-center location fields (EAV)
// ============================================================================

model TradeCenter {
  id        String            @id @default(cuid())
  name      String
  slug      String            @unique
  status    TradeCenterStatus @default(ACTIVE)
  sortOrder Int               @default(0) @map("sort_order")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  fields   TradeCenterField[]
  branches Branch[]

  @@index([status, sortOrder])
  @@map("trade_centers")
}

model TradeCenterField {
  id            String               @id @default(cuid())
  tradeCenterId String               @map("trade_center_id")
  label         String // "Qator", "Pavilon", ...
  type          TradeCenterFieldType @default(TEXT)
  required      Boolean              @default(false)
  sortOrder     Int                  @default(0) @map("sort_order")

  tradeCenter TradeCenter                   @relation(fields: [tradeCenterId], references: [id], onDelete: Cascade)
  values      BranchTradeCenterFieldValue[]

  @@index([tradeCenterId, sortOrder])
  @@map("trade_center_fields")
}

// EAV: one row per (branch, field) — the branch's value for a trade-center field.
model BranchTradeCenterFieldValue {
  id       String @id @default(cuid())
  branchId String @map("branch_id")
  fieldId  String @map("field_id")
  value    String

  branch Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  field  TradeCenterField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([branchId, fieldId])
  @@index([fieldId])
  @@map("branch_trade_center_field_values")
}

// ============================================================================
// MIGRATION NOTE — raw SQL to append to the generated migration (PostGIS)
// ----------------------------------------------------------------------------
// Prisma creates the postgis extension (extensions = [postgis]) and the geo_point
// column (Unsupported), but it cannot manage the GiST index or auto-population.
// Add the following to the migration AFTER `prisma migrate dev --create-only`:
//
//   -- keep geo_point in sync with lat/lng
//   CREATE OR REPLACE FUNCTION branches_set_geo_point() RETURNS trigger AS $$
//   BEGIN
//     NEW.geo_point := ST_SetSRID(ST_MakePoint(NEW.lng, NEW.lat), 4326)::geography;
//     RETURN NEW;
//   END;
//   $$ LANGUAGE plpgsql;
//
//   CREATE TRIGGER branches_geo_point_biu
//     BEFORE INSERT OR UPDATE OF lat, lng ON branches
//     FOR EACH ROW EXECUTE FUNCTION branches_set_geo_point();
//
//   -- proximity index for ST_DWithin / ST_Distance (GET /discounts)
//   CREATE INDEX branches_geo_point_gist ON branches USING GIST (geo_point);
//
//   -- optional: JSONB GIN index for attribute filters ("only halal", etc.)
//   CREATE INDEX listings_attributes_gin ON listings USING GIN (attributes jsonb_path_ops);
//
// (A STORED generated column is an alternative to the trigger, but Prisma cannot
//  represent generated columns on Unsupported types, so the trigger is recommended.)
// ============================================================================
