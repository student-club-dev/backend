# ---- App ----
# NODE_ENV=production activates fail-fast guards: the app REFUSES to boot with
# SMS_PROVIDER=dev or GEOCODER_PROVIDER=dev, because those stubs would silently
# disable real SMS and geocoding. Set the real providers below before deploying.
NODE_ENV=development
PORT=3000
API_PREFIX=v1

# ---- Swagger docs (Basic auth) ----
# Docs live at /${SWAGGER_PATH} (UI) and /${SWAGGER_PATH}/json (the OpenAPI JSON for codegen).
# Set SWAGGER_PASSWORD to require login; in production the docs are hidden entirely until it is set.
# Change SWAGGER_PATH to a non-obvious value to also keep the URL off crawlers. Never commit the real
# password — set it only in the server .env.
SWAGGER_PATH=docs
SWAGGER_USER=admin
SWAGGER_PASSWORD=

# ---- Database (PostgreSQL + PostGIS) ----
# Value for running the app on the HOST. Under docker-compose the backend and migrate
# services override this with the `db` service name — inside a container `localhost`
# is the container itself, not Postgres.
DATABASE_URL=postgresql://elonuz:elonuz@localhost:5432/elonuz?schema=public

# ---- JWT (our own auth) ----
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_TTL=30d

# ---- OAuth ----
# Comma-separated Google client ids (business/student × android/ios/web). A token is accepted
# if its audience matches any of them. Add more here — no code change needed.
GOOGLE_ALLOWED_CLIENT_IDS=
APPLE_OAUTH_CLIENT_ID=

# ---- SMS OTP — stored in Redis, 5-min TTL (see docs/architecture/otp-sms-eskiz.md) ----
# SMS_PROVIDER: `dev` logs the code to the console (local only); `eskiz` sends real SMS.
# Switching to real SMS is env-only: set SMS_PROVIDER=eskiz and fill the ESKIZ_* creds below.
SMS_PROVIDER=dev
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
ESKIZ_BASE_URL=https://notify.eskiz.uz
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESEND=5
# Fixed dev code, honoured only when NODE_ENV != production (defaults to 111111 if unset).
OTP_DEV_CODE=111111

# ---- Geocoding ----
# GEOCODER_PROVIDER: `dev` makes no external call and returns no results (local only);
# `yandex` proxies Yandex Geocoder so the key never reaches the client. Mirrors SMS_PROVIDER —
# `dev` + NODE_ENV=production refuses to boot. The key is only read when a geocode request is
# served, so the app still starts without it (those endpoints return 503 GEOCODER_UNAVAILABLE).
GEOCODER_PROVIDER=dev
YANDEX_GEOCODER_API_KEY=
YANDEX_GEOCODER_BASE_URL=https://geocode-maps.yandex.ru/1.x

# ---- Media (local disk storage) ----
# PUBLIC_MEDIA_BASE_URL is what the mobile clients receive in image URLs — it MUST be the
# public address in production, e.g. https://api.studentclub.uz/uploads. The default below
# is host-local and would hand the apps unreachable links.
UPLOADS_DIR=./uploads
PUBLIC_MEDIA_BASE_URL=http://localhost:3000/uploads

# ---- Redis (BullMQ / cache) ----
# Host value; docker-compose overrides this with the `redis` service name.
REDIS_URL=redis://localhost:6379

# ---- Admin (placeholder) ----
# Compared against the `X-Admin-Key` header by AdminGuard on the admin-only endpoints.
# Leave unset to reject all admin requests. Replaced by real admin auth (admin panel) later.
ADMIN_API_KEY=
