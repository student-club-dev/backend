# ---- App ----
NODE_ENV=development
PORT=3000
API_PREFIX=v1

# ---- Database (PostgreSQL + PostGIS) ----
# docker-compose default; change if using local/cloud Postgres
DATABASE_URL=postgresql://elonuz:elonuz@localhost:5432/elonuz?schema=public

# ---- JWT (our own auth) ----
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_TTL=30d

# ---- OAuth ----
GOOGLE_CLIENT_ID=
APPLE_OAUTH_CLIENT_ID=

# ---- SMS OTP (Eskiz) — stored in Redis, 5-min TTL (see docs/architecture/otp-sms-eskiz.md) ----
SMS_PROVIDER=eskiz
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
SMS_ESKIZ_FROM=4546
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ---- Redis (BullMQ / cache) ----
REDIS_URL=redis://localhost:6379
