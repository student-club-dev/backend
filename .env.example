# ---- App ----
# NODE_ENV=production activates fail-fast guards: the app REFUSES to boot with
# SMS_PROVIDER=dev or GEOCODER_PROVIDER=dev, because those stubs would silently
# disable real SMS and geocoding. Set the real providers below before deploying.
NODE_ENV=development
PORT=3000
API_PREFIX=v1

# CORS_ORIGINS=http://localhost:3000,https://admin.studentclub.uz
CORS_ORIGINS=http://localhost:3000
# Pretty console logs (pino-pretty). LOCAL DEV ONLY — pino-pretty is a devDependency and is
# NOT in the production Docker image, so leave this unset/false on any server (logs stay JSON).
LOG_PRETTY=true

# ---- Swagger docs (Basic auth) ----
# Docs live at /${SWAGGER_PATH} (UI) and /${SWAGGER_PATH}/json (the OpenAPI JSON for codegen).
# Set SWAGGER_PASSWORD to require login; in production the docs are hidden entirely until it is set.
# Change SWAGGER_PATH to a non-obvious value to also keep the URL off crawlers. Never commit the real
# password — set it only in the server .env.
SWAGGER_PATH=docs
SWAGGER_USER=admin
SWAGGER_PASSWORD=

# ---- Database (PostgreSQL + PostGIS) ----
# Value for running the app on the HOST. Under docker-compose the backend and migrate
# services override this with the `db` service name — inside a container `localhost`
# is the container itself, not Postgres.
DATABASE_URL=postgresql://elonuz:elonuz@localhost:5432/elonuz?schema=public

# ---- JWT (our own auth) ----
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_TTL=30d

# ---- OAuth ----
# Comma-separated Google client ids (business/student × android/ios/web). A token is accepted
# if its audience matches any of them. Add more here — no code change needed.
GOOGLE_ALLOWED_CLIENT_IDS=
# Comma-separated Apple client ids (native app bundle ids + any web Services id). A token is
# accepted if its audience matches any of them. Add more here — no code change needed.
APPLE_ALLOWED_CLIENT_IDS=

# ---- SMS OTP — stored in Redis, 5-min TTL (see docs/architecture/otp-sms-eskiz.md) ----
# SMS_PROVIDER: `dev` logs the code to the console (local only); `eskiz` sends real SMS.
# Switching to real SMS is env-only: set SMS_PROVIDER=eskiz and fill the ESKIZ_* creds below.
SMS_PROVIDER=dev
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
ESKIZ_BASE_URL=https://notify.eskiz.uz
# OTP delivery channel: `dev` logs the code (local only); `telegram` sends via Telegram Gateway;
# `sms` sends via SMS_PROVIDER. `dev` + NODE_ENV=production refuses to boot (mirrors SMS_PROVIDER).
OTP_CHANNEL=dev
TELEGRAM_GATEWAY_TOKEN=
TELEGRAM_GATEWAY_BASE_URL=https://gatewayapi.telegram.org
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESEND=5
# Fixed dev code, honoured only when NODE_ENV != production (defaults to 111111 if unset).
OTP_DEV_CODE=111111

# ---- Geocoding ----
# GEOCODER_PROVIDER: `dev` makes no external call and returns no results (local only);
# `yandex` proxies Yandex Geocoder so the key never reaches the client. Mirrors SMS_PROVIDER —
# `dev` + NODE_ENV=production refuses to boot. The key is only read when a geocode request is
# served, so the app still starts without it (those endpoints return 503 GEOCODER_UNAVAILABLE).
GEOCODER_PROVIDER=dev
YANDEX_GEOCODER_API_KEY=
YANDEX_GEOCODER_BASE_URL=https://geocode-maps.yandex.ru/1.x

# ---- Push notifications ----
# PUSH_PROVIDER: `dev` only writes a log line — no notification reaches a device. It refuses to boot
# with NODE_ENV=production (mirrors SMS_PROVIDER), because a silently dropped push is invisible
# until users start complaining about missed messages.
#
# `fcm` covers Android AND iOS: Firebase forwards to APNs once you upload the APNs key to the
# Firebase project, so this is one integration rather than two.
# (VoIP pushes for incoming calls need a direct APNs client — that comes with the calls feature.)
#
# Credentials come from a Firebase service-account JSON:
#   Firebase Console → Project settings → Service accounts → Generate new private key
#   project_id → FCM_PROJECT_ID · client_email → FCM_CLIENT_EMAIL · private_key → FCM_PRIVATE_KEY
# Keep the \n escapes in the private key exactly as the JSON has them; the app converts them.
PUSH_PROVIDER=dev
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ---- Media (local disk storage) ----
# PUBLIC_MEDIA_BASE_URL is what the mobile clients receive in image URLs — it MUST be the
# public address in production, e.g. https://api.studentclub.uz/uploads. The default below
# is host-local and would hand the apps unreachable links.
UPLOADS_DIR=./uploads
PUBLIC_MEDIA_BASE_URL=http://localhost:3000/uploads

# ---- Chat media (private attachments) ----
# NOT the same thing as UPLOADS_DIR above. Listing images are public and served straight off a
# static path; chat attachments are private and only ever leave through GET /v1/media/{id}/raw,
# which checks conversation membership. Never point a web server at this directory.
# Needs a persistent volume in production — see docker-compose.yml.
CHAT_MEDIA_DIR=./uploads/chat

# Per-student abuse limits (chat media spec §9). Defaults shown; override only if you have a reason.
CHAT_UPLOADS_PER_MINUTE=20
CHAT_UPLOAD_BYTES_PER_DAY=524288000

# ffmpeg/ffprobe. Present in the Docker image; set these only for a non-standard local install
# (e.g. Homebrew on Apple Silicon: /opt/homebrew/bin/ffmpeg).
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ---- GIF search ----
KLIPY_API_KEY=JUdlJqRD0dC0DjMxRflkIWSVm0yzJkZqnFLZMxXSrqv4BUgru38F6zBfHyv9tTAS
KLIPY_BASE_URL=https://api.klipy.com/api/v1

# ---- Redis (BullMQ / cache) ----
# Host value; docker-compose overrides this with the `redis` service name.
REDIS_URL=redis://localhost:6379

# ── Calls / TURN ──────────────────────────────────────────────────────────────
# Master switch for the calls feature. Keep "false" until coturn is deployed AND the three
# mobile-client prerequisites have shipped (docs/architecture/calls.md) — until then this backend
# runs in production with the calls code present but no coturn configured, and that must still
# boot. While "false", TURN_HOST/TURN_STATIC_SECRET below are NOT required anywhere and
# GET /v1/calls/ice-servers just answers its existing 503. Once "true", production requires both.
CALLS_ENABLED=false

# coturn host (see deploy/coturn/README.md). TURN_STATIC_SECRET must equal coturn's
# `static-auth-secret`. Required in production once CALLS_ENABLED=true — the app refuses to boot
# without them.
TURN_HOST=
TURN_STATIC_SECRET=
TURN_TTL_SECONDS=3600

# Tears a /calls socket down at (access-token exp + grace) once true — the design's defence
# against a stolen token receiving `call:incoming` indefinitely. MUST STAY "false" until both
# mobile clients send `call:auth` to refresh a socket's token in place: until then, every call
# longer than ~16 minutes would be torn down and close FAILED — strictly worse than today.
CALLS_ENFORCE_TOKEN_EXPIRY=false

# ---- Admin panel auth (env-based, Faza 0) ----
# Admin/moderator login lives in env (no DB table). Passwords are ARGON2 HASHES, never plaintext.
# Generate a hash, e.g.:  node -e "require('@node-rs/argon2').hash(process.argv[1]).then(console.log)" 'yourPassword'
# Leave unset to reject all admin logins. Moderator creds are optional (single-admin setups).
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
MODERATOR_EMAIL=
MODERATOR_PASSWORD_HASH=